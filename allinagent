#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export ALLINAGENT_ROOT="${ALLINAGENT_ROOT:-${SCRIPT_DIR}}"

if command -v python3 >/dev/null 2>&1; then
  exec python3 "${SCRIPT_DIR}/scripts/allinagent_cli.py" "$@"
elif command -v python >/dev/null 2>&1; then
  exec python "${SCRIPT_DIR}/scripts/allinagent_cli.py" "$@"
else
  echo "[allinagent] Error: python3 (>= 3.10) is required to run ALLINAGENT CLI." >&2
  exit 1
fi
