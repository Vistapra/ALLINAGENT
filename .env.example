# ==============================================================================
# ALLINAGENT — Production Environment Template (.env.example)
# Copy to `.env` or run `./allinagent setup` to generate CSPRNG secrets safely.
# Never commit `.env` or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container Image Coordinates (GitHub Container Registry)
# ------------------------------------------------------------------------------
ALLINAGENT_REGISTRY=ghcr.io
ALLINAGENT_IMAGE_NAMESPACE=vistapra
ALLINAGENT_VERSION=latest

# ------------------------------------------------------------------------------
# 2. Telegram Control Center (Fail-Closed by Default)
# Leave OWNER_TELEGRAM_ID blank until configured with your numeric Telegram ID.
# When blank, privileged Telegram mutations remain strictly disabled (fail-closed).
# ------------------------------------------------------------------------------
OWNER_TELEGRAM_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_HANDLE=

# ------------------------------------------------------------------------------
# 3. LLM Provider & Model Defaults (OpenAI-Compatible API)
# Supports OpenAI, OpenRouter, Anthropic-compatible gateways, Ollama, or vLLM.
# ------------------------------------------------------------------------------
CUSTOM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. Organization Identity & Token Budget Governance
# ALLINAGENT_BUDGET_MODE accepts `unlimited` or `capped`.
# ------------------------------------------------------------------------------
COMPANY_NAME="Autonomous AI Engineering & Operations"
ALLINAGENT_BUDGET_MODE=unlimited
ALLINAGENT_MONTHLY_BUDGET_USD=0
UNIFIED_COMPANY_GOVERNANCE=1

# ------------------------------------------------------------------------------
# 5. PostgreSQL Persistence (Paperclip Control Plane)
# POSTGRES_PASSWORD is auto-generated via CSPRNG by `./allinagent setup`.
# ------------------------------------------------------------------------------
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=
POSTGRES_DB=paperclip

# ------------------------------------------------------------------------------
# 6. Host Loopback Ports, Service Endpoints & SSRF Allowlists
# Docker Compose binds strictly to 127.0.0.1:8200-8202 on the host.
# Container-internal URLs (paperclip:3100, office-bridge:3210, hermes:8650,
# vulnclaw:8660) are wired directly in `compose.yaml`.
# ------------------------------------------------------------------------------
ALLINAGENT_BIND_HOST=127.0.0.1
OFFICE_PORT=8200
PAPERCLIP_PORT=8201
OFFICE_BRIDGE_PORT=8202
ALLINAGENT_OFFICE_PORT=8200
ALLINAGENT_PAPERCLIP_PORT=8201
ALLINAGENT_BRIDGE_PORT=8202
ALLINAGENT_WEB_PORT=8200
ALLINAGENT_API_PORT=8201
ALLINAGENT_WS_PORT=8202

PAPERCLIP_BASE_URL=http://127.0.0.1:8201
OFFICE_BRIDGE_HTTP_URL=http://127.0.0.1:8202
OFFICE_BRIDGE_WS_URL=ws://127.0.0.1:8202
UPSTREAM_ALLOWLIST=127.0.0.1,localhost,office-bridge,paperclip,hermes
CUSTOM_RUNTIME_ALLOWLIST=127.0.0.1:8202,localhost:8202,office-bridge

# ------------------------------------------------------------------------------
# 7. Internal Service Secrets (Fail-Closed; Auto-Generated via `./allinagent setup`)
# ------------------------------------------------------------------------------
ALLINAGENT_INTERNAL_TOKEN=
HERMES_EXEC_SHARED_SECRET=
OFFICE_BRIDGE_TOKEN=
STUDIO_ACCESS_TOKEN=
BETTER_AUTH_SECRET=
PAPERCLIP_AGENT_JWT_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
PAPERCLIP_API_KEY=

# ------------------------------------------------------------------------------
# 8. Workspace Isolation, Worker Concurrency & On-Demand Heavy Runtimes
# Optimized for 2 vCPU / 8 GB RAM production hosts by default (<= 1,536 MiB).
# ------------------------------------------------------------------------------
ALLOWED_WORKSPACE_ROOTS=./workspaces
ALLINAGENT_RESOURCE_PROFILE=2_vcpu_8gb_profile
HEAVY_WORKER_CONCURRENCY=1
SECURITY_WORKER_MODE=on-demand
BROWSER_WORKER_MODE=on-demand

# ------------------------------------------------------------------------------
# 9. System Timezone & Zero-Telemetry Privacy Defaults
# ------------------------------------------------------------------------------
TIMEZONE=UTC
NEXT_TELEMETRY_DISABLED=1
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
