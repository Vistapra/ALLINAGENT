# ==============================================================================
# ALLINAGENT — Hardened Nginx Reverse Proxy Vhost Template
# Render with `deploy/proxy/install-nginx.sh` (envsubst whitelist):
#   ${ALLINAGENT_DOMAIN}       e.g. office.example.com
#   ${ALLINAGENT_OFFICE_PORT}  default: 8200
#   ${ALLINAGENT_BRIDGE_PORT}  default: 8202
#   ${ALLINAGENT_TLS_CERT}     e.g. /etc/letsencrypt/live/office.example.com/fullchain.pem
#   ${ALLINAGENT_TLS_KEY}      e.g. /etc/letsencrypt/live/office.example.com/privkey.pem
#
# CRITICAL NGINX HTTP/3 QUIC COMPATIBILITY RULE:
#   NEVER add `reuseport` to `listen 443 quic;` or `listen [::]:443 quic;`!
#   Nginx allows `reuseport` on ONLY ONE server block per IP:port socket
#   (typically owned by `/etc/nginx/sites-enabled/default.conf`).
#
# SECURITY BOUNDARY:
#   PostgreSQL (:5432), Hermes (:8650), VulnClaw (:8660), and Paperclip (:8201)
#   are NEVER exposed publicly through this reverse proxy.
# ==============================================================================

limit_req_zone $binary_remote_addr zone=allinagent_web_limit:10m rate=25r/s;
limit_req_zone $binary_remote_addr zone=allinagent_api_limit:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=allinagent_conn_limit:10m;

map $http_upgrade $allinagent_connection_upgrade {
    default upgrade;
    ''      close;
}

upstream allinagent_office_upstream {
    server 127.0.0.1:${ALLINAGENT_OFFICE_PORT};
    keepalive 16;
}

upstream allinagent_bridge_upstream {
    server 127.0.0.1:${ALLINAGENT_BRIDGE_PORT};
    keepalive 8;
}

# HTTP -> HTTPS Redirect + ACME Challenge
server {
    listen 80;
    listen [::]:80;
    server_name ${ALLINAGENT_DOMAIN};

    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Hardened HTTPS + HTTP/2 (+ Optional HTTP/3 QUIC WITHOUT `reuseport`)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    # Optional HTTP/3 QUIC (Nginx >= 1.25.0). Keep `reuseport` OMITTED so `nginx -t`
    # never collides with an existing `default_server` QUIC listener:
    listen 443 quic;
    listen [::]:443 quic;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;

    server_name ${ALLINAGENT_DOMAIN};
    server_tokens off;

    # TLS 1.2 & TLS 1.3 Configuration
    ssl_certificate     ${ALLINAGENT_TLS_CERT};
    ssl_certificate_key ${ALLINAGENT_TLS_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:ALLINAGENT_SSL:10m;
    ssl_session_tickets off;

    # Defense-in-Depth Security Headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()" always;

    # Client Body & Connection Limits
    client_max_body_size 16m;
    client_body_timeout  30s;
    keepalive_timeout    65s;
    limit_conn           allinagent_conn_limit 40;

    # Block hidden dotfiles & internal paths explicitly
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # 1. Studio Gateway WebSocket Upgrade (`/api/gateway/ws`)
    location = /api/gateway/ws {
        limit_req zone=allinagent_api_limit burst=20 nodelay;
        proxy_pass http://allinagent_office_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $allinagent_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # 2. Company Live Events WebSocket Upgrade (`/api/company/events/ws`)
    location = /api/company/events/ws {
        limit_req zone=allinagent_api_limit burst=20 nodelay;
        proxy_pass http://allinagent_office_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $allinagent_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # 3. Unified Office Bridge Protocol v3 WebSocket (`/ws`)
    location = /ws {
        limit_req zone=allinagent_api_limit burst=20 nodelay;
        proxy_pass http://allinagent_bridge_upstream/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $allinagent_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # 4. Authenticated Company & Studio REST Proxy (`/api/*`)
    location /api/ {
        client_max_body_size 1m;
        limit_req zone=allinagent_api_limit burst=30 nodelay;
        proxy_pass http://allinagent_office_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # 5. Hermes3D & 2D Pixel Virtual Office Frontend
    location / {
        limit_req zone=allinagent_web_limit burst=60 nodelay;
        proxy_pass http://allinagent_office_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $allinagent_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
