<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="src/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="AcmeBistro Payment Security Suite">
            <file>tests/PaymentSecurityTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="ACME_SEEDED_VULNS" value="0"/>
    </php>
</phpunit>
