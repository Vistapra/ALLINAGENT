{
  "name": "acmebistro/synthetic-order-api",
  "description": "AcmeBistro Order API - First-party MIT synthetic Laravel-style PHP REST API and SQLite security test fixture for ALLINAGENT Phase 27 Group E.",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "synthetic-fixture",
    "order-api",
    "acmepay-sandbox",
    "security-benchmark",
    "idempotency",
    "sqlite"
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "AcmeBistro\\OrderApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AcmeBistro\\OrderApi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/PaymentSecurityTest.php",
    "test:seeded-vulns": "php tests/PaymentSecurityTest.php --with-seeded-vulns",
    "verify": "python3 tests/run_fixture_tests.py"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
